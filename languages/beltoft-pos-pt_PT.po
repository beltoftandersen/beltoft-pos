#. Plugin Name of the plugin
#: beltoft-pos.php
msgid "Beltoft POS"
msgstr "Beltoft POS"

#. Description of the plugin
#: beltoft-pos.php
msgid "Point of sale for the shop counter: its own host, login, product list and checkout."
msgstr "Ponto de venda para o balcão da loja: o seu próprio domínio, início de sessão, lista de produtos e checkout."

#. Author of the plugin
#: beltoft-pos.php
msgid "beltoft.net"
msgstr "beltoft.net"

#: src/Checkout/Page.php:112
msgid "Till not set up."
msgstr "Caixa não configurada."

#: src/Checkout/Page.php:128
msgid "The till has no page yet. Publish the POS page and set its ID in the option beltoft_pos_page_id."
msgstr "A caixa ainda não tem página. Publique a página da caixa e defina o seu ID na opção beltoft_pos_page_id."

#: src/Checkout/Tender.php:41
msgid "Records how a counter sale was paid. No payment is processed."
msgstr "Regista como foi paga uma venda ao balcão. Nenhum pagamento é processado."

#: src/Checkout/Tender.php:67
msgid "This payment method is only available at the till."
msgstr "Este método de pagamento só está disponível na caixa."

#. translators: %s: the tender, e.g. Cash.
#: src/Checkout/Tender.php:75
#, php-format
msgid "Counter sale paid: %s"
msgstr "Venda ao balcão paga: %s"

#: src/Checkout/Tenders.php:19
msgid "MB WAY"
msgstr "MB WAY"

#: src/Checkout/Tenders.php:20
msgid "Card (Teya)"
msgstr "Cartão (Teya)"

#: src/Checkout/Tenders.php:21
msgid "Cash"
msgstr "Dinheiro"

#: src/Checkout/Tenders.php:22
msgid "Bank transfer"
msgstr "Transferência bancária"

#: src/Host/Gate.php:376
msgid "Please sign in to the till."
msgstr "Inicie sessão na caixa."

#: src/Host/Gate.php:377
#: src/Receipt/Email.php:65
msgid "This account has no access to the till."
msgstr "Esta conta não tem acesso à caixa."

#: src/Plugin.php:81
msgid "Beltoft POS needs WooCommerce."
msgstr "O Beltoft POS precisa do WooCommerce."

#. translators: %s: email address.
#: src/Receipt/Email.php:52
#, php-format
msgid "Receipt sent to %s."
msgstr "Recibo enviado para %s."

#: src/Receipt/Email.php:71
msgid "This order is not a till sale."
msgstr "Esta encomenda não é uma venda da caixa."

#: src/Receipt/Email.php:87
msgid "Enter a valid email address."
msgstr "Introduza um endereço de email válido."

#. translators: %s: email address.
#: src/Receipt/Email.php:97
#, php-format
msgid "Receipt emailed to %s."
msgstr "Recibo enviado por email para %s."

#: src/Receipt/Email.php:103
msgid "The receipt could not be sent."
msgstr "Não foi possível enviar o recibo."

#: src/Stock/AdminField.php:42
#: src/Stock/AdminField.php:72
msgid "Till stock"
msgstr "Stock da caixa"

#: src/Stock/AdminField.php:91
msgid "Counted separately from the shop stock above. Leave empty if it has never been counted. The till never refuses a sale over this count, so it can go below zero."
msgstr "Contado à parte do stock da loja acima. Deixe vazio se nunca foi contado. A caixa nunca recusa uma venda por causa desta contagem, por isso pode ficar abaixo de zero."

#. translators: %d: number of products whose till stock has gone below zero.
#: src/Stock/Recount.php:113
#, php-format
msgid "%d product has sold past its counted till stock. The sales went through; the count needs correcting."
msgid_plural "%d products have sold past their counted till stock. The sales went through; the counts need correcting."
msgstr[0] "%d produto vendeu mais do que o stock contado da caixa. As vendas foram feitas; a contagem tem de ser corrigida."
msgstr[1] "%d produtos venderam mais do que o stock contado da caixa. As vendas foram feitas; as contagens têm de ser corrigidas."

#: src/Stock/Recount.php:123
msgid "Show them"
msgstr "Mostrar"

#: src/Support/Installer.php:26
msgid "Till operator"
msgstr "Operador de caixa"

#: src/Support/Options.php:46
msgid "Walk-in customer"
msgstr "Cliente de balcão"

#. translators: %s: template slug.
#: src/Bricks/Chrome.php:83
#, php-format
msgid "The till has no header: publish a Bricks header template with the slug %s (no conditions)."
msgstr "A caixa não tem cabeçalho: publique um template de cabeçalho do Bricks com o slug %s (sem condições)."

#: src/Catalog/LoopQuantity.php:111
#: src/Catalog/LoopQuantity.php:188
msgid "Quantity"
msgstr "Quantidade"

#: src/Catalog/LoopQuantity.php:115
#: src/Catalog/LoopQuantity.php:190
msgid "Decrease quantity"
msgstr "Diminuir quantidade"

#: src/Catalog/LoopQuantity.php:116
#: src/Catalog/LoopQuantity.php:191
msgid "Increase quantity"
msgstr "Aumentar quantidade"

#: src/Catalog/LoopQuantity.php:139
msgid "Sold out"
msgstr "Esgotado"

#. translators: %d: units in stock.
#: src/Catalog/LoopQuantity.php:213
#, php-format
msgid "Only %d in stock."
msgstr "Apenas %d em stock."

#. translators: %d: units in stock.
#: src/Catalog/LoopQuantity.php:215
#, php-format
msgid "Could not add. Only %d in stock."
msgstr "Não foi possível adicionar. Apenas %d em stock."

#: src/Catalog/LoopQuantity.php:216
msgid "Could not add this line."
msgstr "Não foi possível adicionar esta linha."

#: src/Receipt/Printing.php:50
msgid "Till printing is on (1/0)"
msgstr "Impressão na caixa ligada (1/0)"

#. translators: 1: product id, 2: till stock before, 3: till stock after.
#: src/Stock/Pool.php:231
#, php-format
msgid "Till stock of item #%1$s: %2$s → %3$s."
msgstr "Stock da caixa do artigo #%1$s: %2$s → %3$s."

#: src/Plugin.php:68
msgid "Beltoft POS is not reachable: set the till's hostname with <code>define( 'BELTOFT_POS_HOST', 'pos.example.com' );</code> in wp-config.php."
msgstr "O Beltoft POS não está acessível: defina o endereço da caixa com <code>define( 'BELTOFT_POS_HOST', 'pos.example.com' );</code> no wp-config.php."

#: src/Receipt/Email.php:81
msgid "This receipt belongs to another operator's sale."
msgstr "Este recibo pertence a uma venda de outro operador."
